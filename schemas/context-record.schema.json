{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-architect.example/schemas/context-record.schema.json",
  "title": "context-record",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "company_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "domain": {
      "$ref": "common.schema.json#/$defs/domain"
    },
    "subject_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "kind": {
      "enum": [
        "confirmed_fact",
        "founder_decision",
        "research_evidence",
        "hypothesis",
        "aspiration",
        "unknown"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "temporal_status": {
      "enum": [
        "current",
        "historical",
        "planned",
        "unknown"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/confidence"
    },
    "verification_method": {
      "enum": [
        "direct_observation",
        "corroborated",
        "founder_attested",
        "not_verified"
      ]
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "next_review_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sensitivity": {
      "$ref": "common.schema.json#/$defs/sensitivity"
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    },
    "lifecycle": {
      "enum": [
        "active",
        "superseded",
        "retracted"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "related_record_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "company_id",
    "domain",
    "subject_key",
    "kind",
    "statement",
    "value",
    "scope",
    "temporal_status",
    "source_ids",
    "owner",
    "confidence",
    "verification_method",
    "verified_at",
    "next_review_at",
    "sensitivity",
    "review",
    "lifecycle",
    "supersedes",
    "related_record_ids",
    "notes",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "confirmed_fact"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "not": {
              "type": "null"
            }
          },
          "source_ids": {
            "minItems": 1
          },
          "verified_at": {
            "type": "string",
            "format": "date"
          },
          "verification_method": {
            "enum": [
              "direct_observation",
              "corroborated",
              "founder_attested"
            ]
          },
          "temporal_status": {
            "enum": [
              "current",
              "historical"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "founder_decision"
          }
        }
      },
      "then": {
        "properties": {
          "source_ids": {
            "minItems": 1
          },
          "review": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "research_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "source_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          },
          "verification_method": {
            "const": "not_verified"
          },
          "confidence": {
            "properties": {
              "level": {
                "const": "unassessed"
              }
            }
          }
        }
      }
    }
  ]
}

